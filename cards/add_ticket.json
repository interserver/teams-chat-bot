{
    "$schema": "https://adaptivecards.io/schemas/adaptive-card.json",
    "body": [
        {
            "type": "ColumnSet",
            "columns": [
                {
                    "type": "Column",
                    "width": "stretch",
                    "items": [
                        {
                            "type": "ColumnSet",
                            "columns": [
                                {
                                    "type": "Column",
                                    "width": "auto",
                                    "items": [
                                        {
                                            "type": "Icon",
                                            "name": "TicketHorizontal",
                                            "color": "Accent",
                                            "size": "Small"
                                        }
                                    ],
                                    "verticalContentAlignment": "Center"
                                },
                                {
                                    "type": "Column",
                                    "width": "stretch",
                                    "spacing": "ExtraSmall",
                                    "items": [
                                        {
                                            "type": "TextBlock",
                                            "text": "Create Support Ticket",
                                            "wrap": true,
                                            "weight": "Bolder",
                                            "color": "Accent",
                                            "size": "Large"
                                        }
                                    ],
                                    "verticalContentAlignment": "Center"
                                }
                            ],
                            "spacing": "ExtraSmall"
                        }
                    ]
                }
            ],
            "spacing": "None"
        },
        {
            "items": [
                {
                    "type": "ColumnSet",
                    "columns": [
                        {
                            "type": "Column",
                            "width": "stretch",
                            "items": [
                                {
                                    "type": "Input.ChoiceSet",
                                    "label": "Status",
                                    "choices": [
                                        {
                                            "title": "Open",
                                            "value": "4"
                                        },
                                        {
                                            "title": "On Hold",
                                            "value": "5"
                                        },
                                        {
                                            "title": "Closed",
                                            "value": "6"
                                        },
                                        {
                                            "title": "In Progress",
                                            "value": "7"
                                        }
                                    ],
                                    "placeholder": "Select Status",
                                    "id": "status",
                                    "isRequired": true,
                                    "errorMessage": "Status is required",
                                    "value": "4",
                                    "spacing": "None"
                                }
                            ]
                        },
                        {
                            "type": "Column",
                            "width": "stretch",
                            "items": [
                                {
                                    "type": "Input.ChoiceSet",
                                    "label": "Priority",
                                    "choices": [
                                        {
                                            "title": "Standard",
                                            "value": "7"
                                        },
                                        {
                                            "title": "Emergency",
                                            "value": "8"
                                        },
                                        {
                                            "title": "Critical",
                                            "value": "9"
                                        }
                                    ],
                                    "placeholder": "Select Priority",
                                    "id": "priority",
                                    "isRequired": true,
                                    "errorMessage": "Priority is required",
                                    "value": "7",
                                    "spacing": "None"
                                }
                            ]
                        }
                    ]
                }
            ],
            "layouts": [
                {
                    "columnSpacing": "Small",
                    "itemFit": "Fill",
                    "minItemWidth": "0px",
                    "rowSpacing": "Small",
                    "type": "Layout.Flow"
                }
            ],
            "spacing": "None",
            "type": "Container"
        },
        {
            "type": "Container",
            "items": [
                {
                    "type": "ColumnSet",
                    "columns": [
                        {
                            "type": "Column",
                            "width": "stretch",
                            "items": [
                                {
                                    "type": "Input.ChoiceSet",
                                    "label": "Type",
                                    "choices": [
                                        {
                                            "title": "Issue",
                                            "value": "1"
                                        },
                                        {
                                            "title": "Task",
                                            "value": "2"
                                        },
                                        {
                                            "title": "Bug",
                                            "value": "3"
                                        },
                                        {
                                            "title": "Lead",
                                            "value": "4"
                                        },
                                        {
                                            "title": "Feedback",
                                            "value": "5"
                                        }
                                    ],
                                    "placeholder": "Select Type",
                                    "isRequired": true,
                                    "errorMessage": "Type is required",
                                    "value": "1",
                                    "id": "type",
                                    "spacing": "None"
                                }
                            ]
                        },
                        {
                            "type": "Column",
                            "width": "stretch",
                            "items": [
                                {
                                    "choices": [
                                        {
                                            "title": "New Unassigned",
                                            "value": "18"
                                        },
                                        {
                                            "title": "Mail Baby",
                                            "value": "28"
                                        },
                                        {
                                            "title": "General",
                                            "value": "5"
                                        },
                                        {
                                            "title": "  >  int-1",
                                            "value": "13"
                                        },
                                        {
                                            "title": "Migrations",
                                            "value": "17"
                                        },
                                        {
                                            "title": "Level 2",
                                            "value": "19"
                                        },
                                        {
                                            "title": "Billing",
                                            "value": "2"
                                        },
                                        {
                                            "title": "Hardware",
                                            "value": "6"
                                        },
                                        {
                                            "title": "  >  Provisioning",
                                            "value": "26"
                                        },
                                        {
                                            "title": "  >  hardware-modifications",
                                            "value": "27"
                                        },
                                        {
                                            "title": "Windows",
                                            "value": "7"
                                        },
                                        {
                                            "title": "  >  Win-Migrations",
                                            "value": "24"
                                        },
                                        {
                                            "title": "  >  Win-Escalations",
                                            "value": "25"
                                        },
                                        {
                                            "title": "Host Department",
                                            "value": "10"
                                        },
                                        {
                                            "title": "HDbilling",
                                            "value": "12"
                                        },
                                        {
                                            "title": "Escalation",
                                            "value": "4"
                                        },
                                        {
                                            "title": "Sales",
                                            "value": "15"
                                        },
                                        {
                                            "title": "  >  Legal",
                                            "value": "23"
                                        },
                                        {
                                            "title": "Developer Escalation",
                                            "value": "14"
                                        },
                                        {
                                            "title": "  >  Security",
                                            "value": "20"
                                        },
                                        {
                                            "title": "  >  New Features",
                                            "value": "21"
                                        },
                                        {
                                            "title": "  >  Bugs",
                                            "value": "22"
                                        },
                                        {
                                            "title": "Abuse",
                                            "value": "16"
                                        }
                                    ],
                                    "errorMessage": "Department is required",
                                    "id": "department",
                                    "isRequired": true,
                                    "label": "Department",
                                    "type": "Input.ChoiceSet",
                                    "value": "5",
                                    "placeholder": "Select Department",
                                    "spacing": "None"
                                }
                            ]
                        }
                    ]
                }
            ],
            "spacing": "None"
        },
        {
            "id": "subject",
            "label": "Subject",
            "placeholder": "Enter subject of ticket",
            "spacing": "None",
            "type": "Input.Text",
            "isRequired": true,
            "errorMessage": "Subject is required"
        },
        {
            "type": "Input.Text",
            "label": "Contents",
            "placeholder": "Enter ticket contents here",
            "id": "contents",
            "isMultiline": true,
            "isRequired": true,
            "errorMessage": "Contents are required.",
            "spacing": "None"
        },
        {
            "columns": [
                {
                    "items": [
                        {
                            "inlines": [
                                {
                                    "selectAction": {
                                        "targetElements": [
                                            "notes",
                                            "chevronUp",
                                            "chevronDown"
                                        ],
                                        "type": "Action.ToggleVisibility"
                                    },
                                    "text": "Add Note",
                                    "type": "TextRun"
                                }
                            ],
                            "type": "RichTextBlock"
                        }
                    ],
                    "type": "Column",
                    "verticalContentAlignment": "Center",
                    "width": "auto"
                },
                {
                    "items": [
                        {
                            "color": "Accent",
                            "id": "chevronDown",
                            "name": "ChevronDown",
                            "size": "xxSmall",
                            "type": "Icon"
                        },
                        {
                            "color": "Accent",
                            "id": "chevronUp",
                            "isVisible": false,
                            "name": "ChevronUp",
                            "size": "xxSmall",
                            "spacing": "None",
                            "type": "Icon"
                        }
                    ],
                    "selectAction": {
                        "targetElements": [
                            "notes",
                            "chevronUp",
                            "chevronDown"
                        ],
                        "type": "Action.ToggleVisibility"
                    },
                    "spacing": "Small",
                    "type": "Column",
                    "verticalContentAlignment": "Center",
                    "width": "auto"
                },
                {
                    "type": "Column",
                    "width": "stretch",
                    "items": [
                        {
                            "actions": [
                                {
                                    "style": "positive",
                                    "title": "Submit",
                                    "type": "Action.Submit",
                                    "data": {
                                        "msteams": {
                                            "type": "addTicketSubmit"
                                        }
                                    }
                                }
                            ],
                            "separator": true,
                            "spacing": "None",
                            "type": "ActionSet",
                            "horizontalAlignment": "Right"
                        }
                    ]
                }
            ],
            "spacing": "None",
            "type": "ColumnSet"
        },
        {
            "id": "notes",
            "isMultiline": true,
            "isVisible": false,
            "placeholder": "Enter any additional notes",
            "spacing": "None",
            "type": "Input.Text"
        }
    ],
    "type": "AdaptiveCard",
    "version": "1.5"
}