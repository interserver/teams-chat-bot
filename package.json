{
  "name": "sequential-workflow-adaptive-card",
  "version": "1.0.0",
  "description": "Sequential Workflows in adaptive card",
  "main": "server/index.js",
  "scripts": {
    "dev:teamsfx": "npm run dev",
    "dev": "nodemon --inspect=9239 --signal SIGINT ./server/index.js",
    "test": "node --test 'test/*.test.js'",
    "start": "node server/index.js",
    "watch": "nodemon server/index.js",
    "build": "node build.js",
    "lint": "eslint .",
    "server": "npm install && node server/index.js",
    "manifest": "del \"appManifest\\appManifest.zip\" 2> nul && powershell Compress-Archive appManifest/* appManifest/appManifest.zip"
  },
  "keywords": [],
  "author": "Microsoft",
  "license": "MIT",
  "dependencies": {
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@octokit/rest": "^22.0.1",
    "adaptive-expressions": "^4.23.3",
    "adaptivecards-templating": "^2.3.1",
    "axios": "^1.7.0",
    "body-parser": "^2.3.0",
    "botbuilder": "^4.23.3",
    "botbuilder-dialogs": "^4.23.3",
    "botframework-connector": "^4.23.3",
    "botframework-schema": "^4.23.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "html-entities": "^2.6.0",
    "ioredis": "*",
    "memorystorage": "^0.12.0",
    "mongodb": "*",
    "mysql2": "*",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "globals": "^17.4.0",
    "nodemon": "^3.1.14"
  },
  "overrides": {
    "uuid": "$uuid",
    "fast-xml-parser": "^5.7.0"
  }
